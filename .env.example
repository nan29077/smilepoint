# 스마일 포인트 서버 설정 (이 파일을 .env로 복사해서 사용)
PORT=3070
HOST=127.0.0.1
# 외부에서 접속하는 주소 (OAuth 콜백 주소에 사용)
PUBLIC_URL=http://localhost:3070
# 데모 모드(테스트 계정 로그인·데모 소셜 로그인·데모 초기화·인증번호 화면 표시)
#  - 비워 두면: 내 PC(HOST=127.0.0.1, http 주소)에서만 자동으로 켜지고, 외부에 여는 서버는 자동으로 운영 모드입니다.
#  - off: 운영 모드. 처음 실행하면 샘플 없이 최고 관리자 1명으로 시작하고,
#         기본 비밀번호(smile1234) 계정은 잠그며, 데모 때 쓰던 제휴사 API 키는 모두 재발급합니다.
#  - on : 외부 서버에서도 데모를 강제로 켭니다 (누구나 관리자로 로그인할 수 있으니 시연용으로만).
# DEMO_MODE=
# 운영 모드 최고 관리자 (비워 두면 임시 비밀번호를 서버 로그에 한 번 출력)
ADMIN_EMAIL=admin@smilepoint.kr
ADMIN_PASSWORD=
# 데이터 저장 폴더 (기본: ./data)
# DATA_DIR=./data
# https로 서비스하면 on (PUBLIC_URL이 https면 자동)
# COOKIE_SECURE=on
# 리버스 프록시(nginx 등) 뒤에서 실행할 때 on — X-Forwarded-For의 오른쪽에서 TRUST_PROXY_HOPS번째 값을 접속 IP로 씁니다
# TRUST_PROXY=on
# TRUST_PROXY_HOPS=1
# 제휴사 API 호출을 등록 IP로만 허용
# ENFORCE_PARTNER_IP=on
# 웹훅 발송 끄기
# WEBHOOK_DELIVERY=off
# 비밀번호 재설정 메일: 메일 발송 서비스의 웹훅 주소 (본문 {to, subject, text}를 POST)
# 비워 두면 재설정 링크를 서버 로그에 남기고 관리자에게 알림
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# 출금 계좌 1원 인증: 지급대행·펌뱅킹 업체 연동 주소 (본문 {bank, accountNumber, holder, amount:1, memo:'스마일1234'}를 POST)
# 비워 두면 회원의 계좌 인증 요청을 최고 관리자가 회원 관리 화면에서 명의 확인 후 승인합니다
BANK_VERIFY_URL=
BANK_VERIFY_TOKEN=

# 출금 지급대행(펌뱅킹) API — 계약 후 값을 넣으면 출금 승인 건을 자동 이체합니다.
#  - 비워 두면: 데모 모드는 "모의 지급대행"으로 흐름만 재현, 운영 모드는 관리자가 수동 지급
#  - 요청/응답 필드는 payout.mjs에서 지급대행사 규격에 맞게 조정합니다.
#  - 이체 결과 통지(웹훅) 주소: {PUBLIC_URL}/api/payout/webhook  (서명 헤더 X-Payout-Signature)
PAYOUT_PROVIDER_NAME=
PAYOUT_API_URL=
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
PAYOUT_MERCHANT_ID=
PAYOUT_WEBHOOK_SECRET=

# 소셜 로그인 (키를 넣으면 실제 로그인으로 전환)
# 카카오: developers.kakao.com > 내 애플리케이션 > 카카오 로그인 > Redirect URI = {PUBLIC_URL}/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버: developers.naver.com > 애플리케이션 등록 > Callback URL = {PUBLIC_URL}/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글: console.cloud.google.com > OAuth 클라이언트 > 승인된 리디렉션 URI = {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
