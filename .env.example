# 스마일 포인트 서버 설정 (이 파일을 .env로 복사해서 사용)
PORT=3070
HOST=127.0.0.1
# 외부에서 접속하는 주소 (OAuth 콜백 주소에 사용)
PUBLIC_URL=http://localhost:3070
# 운영 시 off: 테스트 계정 로그인·데모 소셜 로그인·데모 초기화 차단
DEMO_MODE=on
# 데이터 저장 폴더 (기본: ./data)
# DATA_DIR=./data
# https로 서비스하면 on (PUBLIC_URL이 https면 자동)
# COOKIE_SECURE=on
# 리버스 프록시 뒤에서 실행할 때 on (X-Forwarded-For 신뢰)
# TRUST_PROXY=on
# 제휴사 API 호출을 등록 IP로만 허용
# ENFORCE_PARTNER_IP=on
# 웹훅 발송 끄기
# WEBHOOK_DELIVERY=off

# 소셜 로그인 (키를 넣으면 실제 로그인으로 전환)
# 카카오: developers.kakao.com > 내 애플리케이션 > 카카오 로그인 > Redirect URI = {PUBLIC_URL}/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버: developers.naver.com > 애플리케이션 등록 > Callback URL = {PUBLIC_URL}/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글: console.cloud.google.com > OAuth 클라이언트 > 승인된 리디렉션 URI = {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
